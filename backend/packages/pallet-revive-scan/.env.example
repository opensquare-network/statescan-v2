WS_ENDPOINT=wss://polkadot-asset-hub-rpc.polkadot.io
CHAIN=statemint

MONGO_PALLET_REVIVE_SCAN_URL=mongodb://127.0.0.1:27017
MONGO_PALLET_REVIVE_SCAN_NAME=prod-statescan-statemint-revive-1

SCAN_STEP=100

# Optional. It lets src/scripts/rebuild/fetchCallBlocks.js read the whole revive extrinsic
# history from the subscan open api, otherwise only the newest calls the web pages
# serve are reachable. A key is available at https://support.subscan.io
# SUBSCAN_API_KEY=

# Optional. The Blockscout instance the verified contract sync reads from.
BLOCKSCOUT_API_HOST=https://blockscout.polkadot.io
# BLOCKSCOUT_REQUEST_TIMEOUT_MS=30000
# BLOCKSCOUT_REQUEST_RETRIES=4
# BLOCKSCOUT_DETAIL_CONCURRENCY=4
# 0 walks every page, a positive value only the newest pages.
# BLOCKSCOUT_MAX_PAGES=0
# VERIFIED_CONTRACT_UPSERT_BATCH=50
# The lock is refreshed while the sync runs, a crashed run is taken over after it.
# VERIFIED_CONTRACT_SYNC_LOCK_TTL_MS=1800000

USE_META=1
MONGO_META_URL=mongodb://127.0.0.1:27017
MONGO_DB_META_NAME=meta-statemint

# If set, scan the known existed blocks first, then scan the next blocks one by one
USE_KNOWN_HEIGHTS=1
MONGO_DB_KNOWN_HEIGHTS_URL=mongodb://127.0.0.1:27017
MONGO_DB_KNOWN_HEIGHTS_NAME=known-heights-statescan-statemint-revive

LOG_LEVEL=info
NODE_ENV=production
